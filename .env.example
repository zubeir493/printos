APP_NAME=PrintOS
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

PORT=8000
RUN_MIGRATIONS=false

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Database ---
# Local: use sqlite.
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=printos
# DB_USERNAME=printos
# DB_PASSWORD=
# DB_ROOT_PASSWORD=

# --- Session / Cache / Queue ---
# Local: database is fine.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=false

CACHE_STORE=database
QUEUE_CONNECTION=database

# --- Redis (production) ---
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- File Storage ---
# Local: local disk. Production: s3 (Backblaze B2)
FILESYSTEM_DISK=local

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET=
AWS_DEFAULT_REGION=eu-central-003
AWS_ENDPOINT=https://s3.eu-central-003.backblazeb2.com
AWS_USE_PATH_STYLE_ENDPOINT=true
AWS_VERIFY_SSL=true

# --- Mail ---
MAIL_MAILER=mailtrap
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="billing@example.com"
MAIL_FROM_NAME="${APP_NAME}"

MAILTRAP_API_KEY=
MAILTRAP_ENDPOINT=https://send.api.mailtrap.io/api/send

# --- Web Push ---
VAPID_SUBJECT=mailto:admin@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
WEBPUSH_CA_BUNDLE=

VITE_APP_NAME="${APP_NAME}"
