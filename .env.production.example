APP_NAME=PrintOS
APP_ENV=production
APP_DEBUG=false
APP_DOMAIN=print.example.com
APP_URL=https://print.example.com
# Preserve the existing APP_KEY when migrating data from another server.
APP_KEY=

LOG_CHANNEL=stderr
LOG_LEVEL=info
SESSION_DRIVER=redis
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
CACHE_STORE=redis
QUEUE_CONNECTION=redis
REDIS_HOST=redis
REDIS_QUEUE_RETRY_AFTER=180

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=printos
DB_USERNAME=printos
DB_PASSWORD=
DB_ROOT_PASSWORD=
DB_BACKUP_DISK=s3

# Use a private S3-compatible bucket. Set AWS_ENDPOINT for a non-AWS provider.
FILESYSTEM_DISK=local
PRIVATE_FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
AWS_OBJECT_ACL=bucket-owner-full-control
# AWS_ENDPOINT=https://s3.example.com
# Set AWS_OBJECT_ACL=private if your S3-compatible provider requires it.

MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=printos@example.com
MAIL_FROM_NAME="${APP_NAME}"

# Preserve existing keys to keep browser push subscriptions when migrating.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@example.com

# Enable the network connection once the VPS can reach the device privately.
ATTENDANCE_DEVICE_NETWORK_ENABLED=false
ATTENDANCE_DEVICE_ENABLED=false
ATTENDANCE_DEVICE_PROCESSING_ENABLED=false
ATTENDANCE_DEVICE_QUEUE_CONNECTION=redis
ATTENDANCE_DEVICE_QUEUE=attendance
# ZKTECO_HOST=192.168.1.201
# ZKTECO_PORT=4370
# ZKTECO_TRANSPORT=tcp
