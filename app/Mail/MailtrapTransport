<?php

namespace App\Mail;

use Illuminate\Mail\Transport\Transport;
use Illuminate\Mail\Mailable;
use Mailtrap\MailtrapClient;
use Mailtrap\Mime\MailtrapEmail;
use Symfony\Component\Mime\Address;
use Exception;

class MailtrapTransport extends Transport
{
    protected MailtrapClient $client;
    protected array $config;

    public function __construct(array $config)
    {
        $this->config = $config;
        $this->client = MailtrapClient::initSendingEmails(
            apiKey: $config['api_key'] ?? null
        );
    }

    protected function send(\Swift_Mime_SimpleMessage $message): ?\Swift_SentMessage
    {
        try {
            $email = $this->convertMessageToMailtrapEmail($message);
            $response = $this->client->send($email);
            
            // Create a sent message for Laravel's tracking
            $sentMessage = new \Swift_SentMessage($message);
            $sentMessage->setResult($response);
            
            return $sentMessage;
        } catch (Exception $e) {
            throw new Exception('Mailtrap API error: ' . $e->getMessage(), 0, $e);
        }
    }

    protected function convertMessageToMailtrapEmail(\Swift_Mime_SimpleMessage $message): MailtrapEmail
    {
        $email = new MailtrapEmail();

        // Set from address
        $from = $message->getFrom();
        if ($from) {
            $fromAddress = array_keys($from)[0];
            $fromName = array_values($from)[0];
            $email->from(new Address($fromAddress, $fromName));
        }

        // Set to addresses
        $to = $message->getTo();
        if ($to) {
            foreach ($to as $address => $name) {
                $email->to(new Address($address, $name));
            }
        }

        // Set cc addresses
        $cc = $message->getCc();
        if ($cc) {
            foreach ($cc as $address => $name) {
                $email->cc(new Address($address, $name));
            }
        }

        // Set bcc addresses
        $bcc = $message->getBcc();
        if ($bcc) {
            foreach ($bcc as $address => $name) {
                $email->bcc(new Address($address, $name));
            }
        }

        // Set reply-to
        $replyTo = $message->getReplyTo();
        if ($replyTo) {
            $replyAddress = array_keys($replyTo)[0];
            $replyName = array_values($replyTo)[0];
            $email->replyTo(new Address($replyAddress, $replyName));
        }

        // Set subject
        $email->subject($message->getSubject());

        // Set body
        $htmlBody = $message->getBody();
        if ($htmlBody) {
            $email->html($htmlBody);
        }

        // Get plain text from parts if available
        $textBody = null;
        foreach ($message->getChildren() as $child) {
            if ($child->getContentType() === 'text/plain') {
                $textBody = $child->getBody();
                break;
            }
        }

        if ($textBody) {
            $email->text($textBody);
        }

        return $email;
    }

    public function register(): void
    {
        // This method is required by Laravel's transport interface
        // but doesn't need implementation for Mailtrap
    }
}
